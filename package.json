{
  "name": "kontur",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "npm run start",
    "web:dev": "vite",
    "build": "vite build",
    "start": "npm run build && node --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:auth": "playwright test --config tests/e2e/login-logout.config.ts",
    "test:live-review": "node --import tsx tests/live/review-feedback.probe.ts",
    "test:workflow-probe": "node --import tsx tests/unit/workflow/sqlite-resume.probe.ts",
    "lint": "eslint src tests --max-warnings 0",
    "format:check": "prettier --check src tests --ignore-path .prettierignore",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:full": "npm run check && npm run format:check && npm run test:e2e:auth && npm run test:e2e && QA_REAL_CODEX=1 npm run test:e2e && npm run test:live-review"
  },
  "dependencies": {
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.17",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@tanstack/react-query": "5.102.8",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "jsdom": "27.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
